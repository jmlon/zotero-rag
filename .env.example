# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Zotero Web API — create a key at https://www.zotero.org/settings/keys
# ZOTERO_LIBRARY_ID is the numeric userID shown on that page (not your username).
ZOTERO_LIBRARY_ID=
ZOTERO_API_KEY=

# OpenRouter — create a key at https://openrouter.ai/keys
# Only needed for `index` and `query`; `list-collections` does not use it.
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
